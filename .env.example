# ── ИИ-описания профессий ──
# Вариант 1 (бесплатно): Google Gemini API. Ключ: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Модель Gemini (по умолчанию gemini-flash-latest — входит в бесплатный тариф)
GEMINI_MODEL=gemini-flash-latest

# Вариант 2: Vercel AI Gateway (используется, только если ключ Google не задан)
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5.5

# ── Вакансии hh.kz ──
# API hh отдаёт вакансии только зарегистрированным приложениям.
# Зарегистрируйте приложение на https://dev.hh.ru и получите токен приложения (client_credentials).
HH_ACCESS_TOKEN=
HH_USER_AGENT=ProfessionAtlas/1.0 (your-email@example.com)
